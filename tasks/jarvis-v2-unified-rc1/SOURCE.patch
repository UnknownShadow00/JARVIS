+    try:
+        assert recovered.list_tasks(ACTOR)[0]['status'] == 'pending'
+        new = ExecutionPipeline(recovered, p.policy, enabled=True)
+        assert new.run_once(ACTOR)['result']['task_id'] == op
+    finally:
+        recovered.close()
+
+
