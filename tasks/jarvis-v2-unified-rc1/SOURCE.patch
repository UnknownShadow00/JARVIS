+def proposal(env):
+    s,a,target,r,unknown,_=env
+    op=uid();payload=publication_payload(s.guard,target,r)
+    p=grant(s.guard,op,'propose',payload)
+    return op,payload,p,s.apply(ACTOR,op,'propose',payload,p)
