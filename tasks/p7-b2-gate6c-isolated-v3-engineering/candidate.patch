+            status=dict(x.split(':',1) for x in (Path('/proc')/str(pid)/'status').read_text().splitlines() if ':' in x)
+            if int(status['PPid'])!=child.pid or not all(int(x)==os.getuid() for x in status['Uid'].split()):raise ValueError()
