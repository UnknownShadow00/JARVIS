+"""Canonical passive evaluation bridge; no registry handlers, sink or network client."""
+from dataclasses import dataclass
+from datetime import datetime,UTC
+import json
+from .contracts import Refused
+
+@dataclass(frozen=True)
+class Observation:
+    projection: dict
+    parser_input_sha256: str
+    canonical_request_sha256: str
+    profile: str
+
+class CanonicalObserver:
+    def __init__(self,metadata,approval_mode):
+        self.metadata,self.approval_mode=metadata,approval_mode
+        self.owners={}
+
+    def capture(self,session,message,history,transport):
+        from app.execution.shadow_context import ShadowContextV1
+        from app.execution.shadow_admission import CapturedDeliveryV1,HistoryMessageV1
+        from app.execution.shadow_ingress import ShadowIngressEnvelopeV1
+        from app.execution.shadow_pilot import prepare_pilot_request
+        if session not in self.owners:self.owners[session]=ShadowContextV1()
+        owner=self.owners[session]
+        delivery=CapturedDeliveryV1(ShadowIngressEnvelopeV1(message,owner.create_turn()),
+            tuple(HistoryMessageV1(m['role'],m['content']) for m in history),
+            'http' if transport=='REST' else 'websocket',session)
+        return delivery,prepare_pilot_request(delivery)
+
+    def check_request(self,capture,body):
+        if json.loads(body)!=json.loads(capture[1].native_json):raise Refused('CANONICAL_REQUEST_MISMATCH')
+
+    def observe(self,capture,body):
+        from app.execution.shadow_provider_ollama import normalize_qualified_native
+        from app.execution.shadow_evaluator import evaluate_shadow
+        from app.execution.shadow_observation_sink import _observation
+        normalized=normalize_qualified_native(body)
+        evaluated=evaluate_shadow(capture[0],capture[1],normalized,metadata=self.metadata,
+            approval_mode=self.approval_mode,recorded_at=datetime.now(UTC),proposal_ids=())
+        if evaluated.facts.proposal_count!=0 or evaluated.observation is None:raise Refused('CANONICAL_EVALUATION_FAILED')
+        return Observation(_observation(evaluated.observation),normalized.parser_input_sha256,
+                           capture[1].canonical_request_sha256,capture[1].native_profile_id)
