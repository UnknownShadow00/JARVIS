+from __future__ import annotations
+from dataclasses import dataclass
+import json, math
+from typing import Protocol
+from .contracts import Bindings, Refused, canonical, digest, strict_json
+
+@dataclass(frozen=True)
+class VerifiedOperator:
+    identity: str
+    user_present: bool
+
+class Verifier(Protocol):
+    def verify(self, body: bytes, signature: bytes) -> VerifiedOperator: ...
+
+class Authority:
+    """Pure verifier seam. Kernel peer extraction and human signer are not installed."""
+    def __init__(self, bindings: Bindings, verifier: Verifier, *, clock, operator_id: str):
+        self.bindings, self.verifier, self.clock, self.operator_id = bindings, verifier, clock, operator_id
+
+    def check(self, raw: bytes, signature: bytes, peer: tuple[int, int], verb: str) -> dict:
+        if peer[0] != 0 or type(peer[1]) is not int or peer[1] <= 0: raise Refused('CONTROL_PEER')
+        if type(raw) is not bytes or len(raw) > 8192 or type(signature) is not bytes: raise Refused('CONTROL_SIZE')
+        try:
+            a = strict_json(raw)
+            if canonical(a) != raw: raise Refused('NONCANONICAL_CONTROL')
+        except (ValueError, TypeError, RecursionError): raise Refused('CONTROL_SCHEMA') from None
+        if type(a) is not dict or set(a) != {'verb','nonce','expires','bindings','checkpoint','payload'}: raise Refused('CONTROL_SCHEMA')
+        if type(a['checkpoint']) is not str or len(a['checkpoint'])!=64:raise Refused('CONTROL_CHECKPOINT')
+        if a['verb'] != verb or verb not in ('OPEN_HOLD','AUTHORIZE_ONE','TERMINAL_STOP'): raise Refused('CONTROL_VERB')
+        if type(a['nonce']) is not str or len(a['nonce']) != 32 or any(c not in '0123456789abcdef' for c in a['nonce']): raise Refused('CONTROL_NONCE')
+        if type(a['expires']) not in (int,float) or not math.isfinite(a['expires']) or not self.clock() < a['expires'] <= self.clock()+60: raise Refused('CONTROL_EXPIRED')
+        if a['bindings'] != self.bindings.as_dict() or type(a['payload']) is not dict: raise Refused('CONTROL_BINDING')
+        keys = {'transport','session','request_commitment'} if verb == 'AUTHORIZE_ONE' else set()
+        if set(a['payload']) != keys: raise Refused('CONTROL_PAYLOAD')
+        try: operator = self.verifier.verify(raw, signature)
+        except Exception: raise Refused('CONTROL_SIGNATURE') from None
+        if type(operator) is not VerifiedOperator or operator.identity != self.operator_id or operator.user_present is not True: raise Refused('OPERATOR_PRESENCE')
+        return dict(a, _verified_operator=operator.identity, _signed_digest=digest(raw))
