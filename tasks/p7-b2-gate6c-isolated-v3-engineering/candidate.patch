+"""Unregistered ASGI candidate. Test it in-process; contains no socket/listener setup."""
+import asyncio,hmac,json
+from .contracts import Refused,canonical,strict_json
+
+class Ingress:
+    def __init__(self,runtime,*,api_token: bytes):
+        if type(api_token) is not bytes or not api_token:raise Refused('AUTH_REQUIRED')
+        self.runtime,self._token=runtime,api_token
+
+    async def __call__(self,scope,receive,send):
+        kind,path=scope.get('type'),scope.get('path')
+        if kind not in ('http','websocket'):raise Refused('UNSUPPORTED_ASGI_SCOPE')
+        headers=scope.get('headers',[])
+        auth=[v for k,v in headers if k.lower()==b'authorization']
+        ok=len(auth)==1 and hmac.compare_digest(auth[0],b'Bearer '+self._token)
+        if not ok:
+            self.runtime.stop('AUTHENTICATION_MISMATCH')
+            if kind=='websocket':await send({'type':'websocket.close','code':1008})
+            else:await self._http(send,401,{'error':'UNAUTHORIZED'})
+            return
+        if kind=='http':
+            if path!='/chat':await self._http(send,404,{'error':'NOT_FOUND'});return
+            if scope.get('method')!='POST':await self._http(send,405,{'error':'METHOD_NOT_ALLOWED'});return
+            body=b''
+            try:
+                async with asyncio.timeout(self.runtime.legacy.delivery_deadline):
+                    while True:
+                        msg=await receive()
+                        if msg['type']=='http.disconnect':self.runtime.stop('CLIENT_DISCONNECT');return
+                        if msg['type']!='http.request' or type(msg.get('body',b'')) is not bytes:raise Refused('HTTP_PROTOCOL')
+                        body+=msg.get('body',b'')
+                        if len(body)>16384:raise Refused('REQUEST_LIMIT')
+                        if not msg.get('more_body'):break
+            except (TimeoutError,Refused):
+                self.runtime.stop('INGRESS_BODY_REFUSED');await self._http(send,400,{'error':'REQUEST_REFUSED'});return
+            try:
+                value=strict_json(body)
+                if type(value) is not dict or set(value)!={'message'}:raise Refused('REQUEST_SCHEMA')
+                tokens=[v for k,v in headers if k.lower()==b'x-jarvis-continuation']
+                if len(tokens)!=1:raise Refused('CONTINUATION')
+                token=tokens[0].decode('ascii')
+            except (ValueError,UnicodeError,Refused):
+                self.runtime.stop('INGRESS_REFUSAL');await self._http(send,400,{'error':'REQUEST_REFUSED'});return
+            sink=HttpDelivery(send,token)
+            try:await self.runtime.request(transport='REST',token=token,message=value['message'],authenticated=True,delivery=sink)
+            except Refused:
+                if not sink.started:await self._http(send,423,{'error':'PILOT_REFUSED'})
+            return
+        if path!='/ws':await send({'type':'websocket.close','code':1008});return
+        try:
+            first=await asyncio.wait_for(receive(),self.runtime.legacy.delivery_deadline)
+            if first['type']!='websocket.connect':raise Refused('WS_PROTOCOL')
+        except (TimeoutError,Refused):
+            self.runtime.stop('WS_PROTOCOL');await send({'type':'websocket.close','code':1008});return
+        await send({'type':'websocket.accept'});token=None
+        while True:
+            try:message=await asyncio.wait_for(receive(),300)
+            except asyncio.TimeoutError:self.runtime.stop('WS_IDLE');await send({'type':'websocket.close','code':1000});return
+            if message['type']=='websocket.disconnect':return
+            text=message.get('text')
+            if type(text) is not str or len(text.encode())>16384:
+                self.runtime.stop('WS_INPUT');await send({'type':'websocket.close','code':1008});return
+            if text.lstrip().startswith('{'):
+                from app.execution.shadow_admission import parse_continuation_frame
+                try:
+                    control,candidate=parse_continuation_frame(text)
+                    if not control:raise Refused('WS_CONTROL')
+                    self.runtime.session(candidate,'WS');token=candidate
+                except ValueError:
+                    self.runtime.stop('CONTINUATION_MISMATCH');await send({'type':'websocket.close','code':1008});return
+                except Refused:
+                    self.runtime.stop('CONTINUATION_MISMATCH');await send({'type':'websocket.close','code':1008});return
+                continue
+            try:await self.runtime.request(transport='WS',token=token,message=text,authenticated=True,delivery=WsDelivery(send))
+            except Refused:await send({'type':'websocket.close','code':1008});return
+
+    @staticmethod
+    async def _http(send,status,value):
+        await send({'type':'http.response.start','status':status,'headers':[(b'content-type',b'application/json')]})
+        await send({'type':'http.response.body','body':canonical(value)})
+
+class HttpDelivery:
+    def __init__(self,send,token):self.send_frame,self.token,self.started=send,token,False
+    async def send(self,envelope):
+        self.started=True
+        await self.send_frame({'type':'http.response.start','status':200,'headers':[(b'content-type',b'application/json'),(b'x-jarvis-continuation',self.token.encode())]})
+        await self.send_frame({'type':'http.response.body','body':canonical(envelope)})
+        return True  # ASGI send completed; not proof the remote human rendered the reply.
+
+class WsDelivery:
+    def __init__(self,send):self.send_frame=send
+    async def send(self,envelope):
+        await self.send_frame({'type':'websocket.send','text':canonical(envelope).decode()});return True
