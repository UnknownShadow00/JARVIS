+from __future__ import annotations
+
+from dataclasses import dataclass, field
+from hashlib import sha256
+import json
+from urllib.parse import urlsplit
+
+class Refused(RuntimeError):
+    """Fixed nonsecret diagnostic only; never attach provider exceptions or content."""
+
+def canonical(value: object) -> bytes:
+    return json.dumps(value, sort_keys=True, separators=(',', ':'), ensure_ascii=False, allow_nan=False).encode()
+
+def digest(value: bytes) -> str:
+    return sha256(value).hexdigest()
+
+def strict_json(raw):
+    """Reject ambiguous keys and nonfinite constants at every JSON boundary."""
+    def unique(pairs):
+        result = {}
+        for key, value in pairs:
+            if key in result: raise Refused('DUPLICATE_JSON_KEY')
+            result[key] = value
+        return result
+    try:
+        return json.loads(raw, object_pairs_hook=unique,
+            parse_constant=lambda _: (_ for _ in ()).throw(Refused('NONFINITE_JSON')))
+    except (ValueError, UnicodeError, RecursionError):
+        raise Refused('INVALID_JSON') from None
+
+@dataclass(frozen=True)
+class Resource:
+    endpoint: str
+    model: str
+    profile: str
+
+    def __post_init__(self):
+        p = urlsplit(self.endpoint)
+        if (p.scheme != 'http' or not p.hostname or p.username or p.password or p.query or p.fragment
+                or p.path not in ('', '/') or p.port is None or self.endpoint.endswith('/')
+                or not self.model or not self.profile):
+            raise Refused('RESOURCE_BINDING')
+
+@dataclass(frozen=True)
+class Limits:
+    context: int
+    output: int
+    native_bytes: int
+    request_bytes: int
+    deadline: float
+    keep_alive: int
+
+    def __post_init__(self):
+        import math
+        for v in (self.context, self.output, self.native_bytes, self.request_bytes, self.keep_alive):
+            if type(v) is not int or v <= 0: raise Refused('LIMIT_BINDING')
+        if type(self.deadline) not in (int, float) or not math.isfinite(self.deadline) or self.deadline <= 0:
+            raise Refused('DEADLINE_BINDING')
+
+@dataclass(frozen=True)
+class StepContract:
+    resource: Resource
+    limits: Limits
+    system_prompt: str = field(repr=False)
+    qualification: str
+
+    def __post_init__(self):
+        if not self.system_prompt or not self.qualification: raise Refused('PROMPT_QUALIFICATION_BINDING')
+
+@dataclass(frozen=True)
+class Bindings:
+    source: str
+    config: str
+    release: str
+    pid: str
+    invocation: str
+    epoch: str
+    boot: str
+    start: str
+    challenge: str
+
+    def as_dict(self):
+        from dataclasses import asdict
+        return asdict(self)
+
+@dataclass(frozen=True)
+class LegacyRelease:
+    responder: StepContract | None = None
+    router: StepContract | None = None
+    router_policy: str | None = None
+    memory_policy: str | None = None
+    memory_snapshot: str | None = field(default=None, repr=False)
+    policy_approval: str | None = None
+    min_confidence: float | None = None
+    delivery_deadline: float | None = None
+
+    def validate(self):
+        if (self.responder is None or self.router_policy not in ('L1', 'L2_FOUR_INPUTS')
+                or self.memory_policy not in ('NONE', 'SNAPSHOT') or self.memory_snapshot is None
+                or not self.policy_approval or self.router_policy == 'L1' and self.router is None):
+            raise Refused('UNRESOLVED_RELEASE_BINDINGS')
+        if self.memory_policy == 'NONE' and self.memory_snapshot: raise Refused('MEMORY_BINDING')
+        import math
+        if (type(self.min_confidence) not in (int,float) or not math.isfinite(self.min_confidence)
+                or not 0<=self.min_confidence<=1 or type(self.delivery_deadline) not in (int,float)
+                or not math.isfinite(self.delivery_deadline) or self.delivery_deadline<=0):raise Refused('UNRESOLVED_RELEASE_BINDINGS')
+
+@dataclass(frozen=True)
+class ProviderRequest:
+    attempt: str
+    substep: str
+    resource: Resource
+    body: bytes = field(repr=False)
+    request_digest: str
+    deadline: float
+
+@dataclass(frozen=True)
+class ProviderResult:
+    attempt: str
+    substep: str
+    resource: Resource
+    request_digest: str
+    body: bytes = field(repr=False)
+    known_terminal: bool
+
+@dataclass(frozen=True)
+class ViewStatus:
+    dry_run: bool
+    active: bool
+
+    def __post_init__(self):
+        if type(self.dry_run) is not bool or type(self.active) is not bool:raise Refused('VIEW_STATUS_BINDING')
+
+def decode(body: bytes, limit: int) -> dict:
+    if type(body) is not bytes or len(body) > limit: raise Refused('NATIVE_LIMIT')
+    value = strict_json(body)
+    if type(value) is not dict or type(value.get('message')) is not dict: raise Refused('NATIVE_SHAPE')
+    m = value['message']
+    if 'tool_calls' in m or 'tool_calls' in value: raise Refused('TOOL_PROPOSAL')
+    if type(m.get('content')) is not str: raise Refused('CONTENT_SHAPE')
+    if '[action:' in m['content'].lower(): raise Refused('ACTION_PROPOSAL')
+    return value
+
+def build_production_runtime(*args, **kwargs):
+    # Deliberate unavailable release boundary: no live backend/privilege/credential adapter exists.
+    raise Refused('PRODUCTION_BINDINGS_NOT_APPROVED')
