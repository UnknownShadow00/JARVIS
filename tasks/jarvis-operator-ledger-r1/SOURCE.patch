+class OperatorPermits:
+    """HMAC issuer/verifier is trusted-local only; no issuance endpoint."""
+    def __init__(self, key):
+        if type(key) is not bytes or len(key)<32:raise AuthorityError('invalid_operator_key')
+        self._key=key
