[Unit]
Description=Non-root fixed-action serial0 inspection worker
Conflicts=serial-getty@ttyS0.service
ConditionPathExists=/etc/g6k-serial/WORKER-ACTIVATE

[Service]
Type=simple
User=g6k-bridge
Group=g6k-bridge
ExecStart=/usr/bin/python3 -I -B /opt/g6k-serial/entry.py worker
Restart=no
TimeoutStopSec=3
KillMode=control-group
UMask=0077
LimitCORE=0
TTYPath=/dev/ttyS0
TTYReset=yes
TTYVHangup=no
StandardInput=tty
StandardOutput=tty
StandardError=null
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX
SystemCallFilter=~@network-io @mount @reboot @swap @module @raw-io
DevicePolicy=closed
DeviceAllow=/dev/ttyS0 rw
ReadWritePaths=/var/lib/g6k-serial-worker
TasksMax=1
MemoryMax=64M
CPUQuota=10%

[Install]
WantedBy=multi-user.target
