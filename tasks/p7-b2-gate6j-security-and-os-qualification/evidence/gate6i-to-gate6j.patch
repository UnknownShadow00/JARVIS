+def probe(pipe,fd,identity):
+    try:
+        st=os.fstat(fd);inherited=(st.st_dev,st.st_ino)==identity
+    except OSError:inherited=False
+    pipe.send(inherited);pipe.close()
+
+def safe_child(pipe):
+    pipe.send({'uid':os.getuid(),'pid':os.getpid()});pipe.close()
+
