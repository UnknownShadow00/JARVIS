+    release.set()
+    await s.stop()
+    assert task.done() and s._backend is None
+
+
+@pytest.mark.asyncio
+async def test_closed_real_backend_cannot_reopen_stale_cleanup_inventory(env):
+    s=Scheduler()
+    await s.start()
+    backend=s._backend
+    await s.stop()
+    with pytest.raises(AuthorityError,match='scheduler_backend_closed'):
