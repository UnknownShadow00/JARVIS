+def test_witness_expiring_during_expensive_derive_never_publishes(registry,monkeypatch):
+    import app.agent.recovery_decisions as module
+    s,*_=registry;op=uid();body=publication_payload(s.guard,registry[2],registry[3])
+    p=grant(s.guard,op,'propose',body,seconds=299)
+    shift=[0]
+    class Clock(datetime):
+        @classmethod
+        def now(cls,tz=None):return datetime.now(tz)+timedelta(seconds=shift[0])
+    monkeypatch.setattr(module,'datetime',Clock)
+    original=s._derive
+    def delayed(events,committed_count,history_state):
+        result=original(events,committed_count,history_state)
+        if len(events)>committed_count:shift[0]=130
+        return result
+    monkeypatch.setattr(s,'_derive',delayed)
+    with pytest.raises(AuthorityError,match='recovery_witness_admission_expired'):s.apply(ACTOR,op,'propose',body,p)
+    assert not s._path(2,'intent').exists()
+
+
