+@pytest.mark.parametrize('verb',[SUCCESSOR_VERB,'AUTHORIZE_ONE','SEND','SETTLE'])
+@pytest.mark.parametrize('boundary,expected',[('before_commit',0),('after_commit',1)])
+def test_real_process_interruption_atomic_nonce_and_restart(f,boundary,expected,verb):
+    if verb in ('AUTHORIZE_ONE','SEND','SETTLE'): f.successor();f.checkpoint()
+    if verb in ('SEND','SETTLE'): f.send(f.permit())
+    if verb=='SETTLE':send_step(f,'legacy_normal')
+    initial=f.journal.read()['seq']
+    packet=f.envelope(SUCCESSOR_VERB) if verb==SUCCESSOR_VERB else f.permit()
+    expected_state={k:f.journal.read()[k] for k in ('seq','seal')}
+    association=f.journal.read()['pending']
+    if verb=='SEND':
+        action=f"j.possible_send(peer=(os.getuid(),os.getpid()),expected={expected_state!r},ordinal=1,role='legacy_normal',request_digest='b'*64)"
+    elif verb=='SETTLE':
+        action=f"j.settle(peer=(os.getuid(),os.getpid()),expected={expected_state!r},terminal_reader=lambda:{{'terminal':True,'association':{association!r}}})"
+    else:action=f"j.signed({packet[0]!r},{packet[1]!r},(os.getuid(),os.getpid()),{verb!r})"
+    # fork would keep pytest's sqlite locks; launch a fresh process instead.
+    # Only public-key bytes and synthetic signed command enter the child.
+    pub=f.key.public_key().public_bytes(serialization.Encoding.Raw,serialization.PublicFormat.Raw)
+    script=f'''import os,sys
+sys.path.append('/usr/lib/python3/dist-packages')
+from candidate_v3.protected_authority import *
+from candidate_v3.contracts import Bindings
+from candidate_v3.authority import Authority
+from candidate_v3.lineage import PredecessorProof
+b=Bindings(**{f.bindings.as_dict()!r})
+a=Authority(b,Ed25519Verifier({pub!r},operator_id='fixture-human'),clock=lambda:100.,operator_id='fixture-human',peer_uid=os.getuid())
+p=PredecessorProof('parent','a'*64,0,'b'*64,config_digest='c'*64,controller_digest='d'*64,live_state_digest='e'*64)
+def fault(point):
+ if point=={boundary!r}:os._exit(77)
+j=ProtectedJournal({str(f.root)!r},owner_uid=os.getuid(),service_uid=os.getuid(),authority=a,predecessor_reader=lambda:p,identity_reader=b.as_dict,provider_resources={{'legacy_normal':digest(b'legacy_normal')}},fault=fault)
+{action}
+'''
+    result=subprocess.run([sys.executable,'-c',script],capture_output=True)
+    assert result.returncode==77,result.stderr.decode()
+    assert f.journal.read()['seq']==initial+expected
+    if verb in ('SEND','SETTLE'):
+        fn=lambda:send_step(f,'legacy_normal') if verb=='SEND' else settle_step(f)
+        if expected:
+            with pytest.raises(Refused):fn()
+        else:fn()
+    elif expected:
+        with pytest.raises(Refused,match='REPLAY'):f.send(packet)
+    else:f.send(packet)
+
