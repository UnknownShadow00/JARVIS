+"""Gate 6H disposable authority prototype, NOT a production runtime factory.
+
+Reuses the 6G signed command schema and predecessor proof. The only writer is
+intended to run in a protected OS identity. Same-UID fixtures do not provide that
+boundary. No keys, shell, provider, arbitrary path or recovery/reset API.
+"""
+import os
+from pathlib import Path
+import sqlite3
+import stat
+import threading
+
+from .authority import Authority, SUCCESSOR_VERB, VerifiedOperator
+from .contracts import Refused, canonical, digest, strict_json
+from .lineage import successor_payload
+from .storage import no_symlink_ancestors, sync_dir
+
+SCHEMA = (
+    'CREATE TABLE events(seq INTEGER PRIMARY KEY, nonce TEXT UNIQUE NOT NULL, kind TEXT NOT NULL, body TEXT NOT NULL, prior TEXT NOT NULL, seal TEXT NOT NULL)',
+    "CREATE TRIGGER no_update BEFORE UPDATE ON events BEGIN SELECT RAISE(ABORT,'IMMUTABLE'); END",
+    "CREATE TRIGGER no_delete BEFORE DELETE ON events BEGIN SELECT RAISE(ABORT,'IMMUTABLE'); END",
+)
+ZERO = '0' * 64
+
+
+class Ed25519Verifier:
+    """Public key only. Peer/presence policy is independent of a valid signature.
+
+    Presence means delivery via the separately authenticated operator socket;
+    ordinary Ed25519 does not prove touch or biometric hardware presence.
+    """
+    def __init__(self, public_key, *, operator_id):
+        if type(public_key) is not bytes or len(public_key) != 32:
+            raise Refused('AUTHORITY_PUBLIC_KEY')
+        from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PublicKey
+        self.key = Ed25519PublicKey.from_public_bytes(public_key)
+        self.operator_id = operator_id
+
+    def verify(self, body, signature):
+        if type(signature) is not bytes or len(signature) != 64:
+            raise Refused('AUTHORITY_SIGNATURE')
+        self.key.verify(signature, body)
+        return VerifiedOperator(self.operator_id, True)
+
+
+class ProtectedJournal:
+    """Append-only transaction engine; pinned paths/readers provided by installer.
+
+    Invariants are checked under BEGIN IMMEDIATE, including the fresh protected
+    identity reader. Durably reserved attempts burn before local acceptance.
+    A missing acknowledgement is uncertain and never a refund. Restart always
+    requires fresh invocation binding; no rebind method exists in this prototype.
+    """
+    def __init__(self, root, *, owner_uid, service_uid, authority, predecessor_reader,
+                 identity_reader, provider_resources=None, create=False, fault=lambda _: None):
+        if (type(owner_uid) is not int or type(service_uid) is not int
+                or min(owner_uid, service_uid) < 0 or type(authority) is not Authority):
+            raise Refused('AUTHORITY_CONFIGURATION')
+        self.root = Path(root).absolute()
+        self.owner_uid, self.service_uid = owner_uid, service_uid
+        self.authority, self.predecessor_reader = authority, predecessor_reader
+        self.identity_reader, self.fault = identity_reader, fault
+        self.provider_resources = dict(provider_resources or {})
+        self.lock = threading.RLock()
+        self.path = self.root/'authority.sqlite3'
+        self.db = None
+        try:
+            self._path(self.root, directory=True)
+            if create:
+                fd = os.open(self.path, os.O_CREAT|os.O_EXCL|os.O_NOFOLLOW|os.O_RDWR, 0o600)
+                os.close(fd)
+            self._path(self.path)
+            self.inode = self.path.stat().st_ino
+            # mode=rw refuses implicit recreation of a missing authority.
+            self.db = sqlite3.connect(self.path.as_uri()+'?mode=rw', uri=True,
+                                      isolation_level=None, check_same_thread=False, timeout=2)
+            self.db.execute('PRAGMA synchronous=FULL')
+            self.db.execute('PRAGMA journal_mode=DELETE')
+            if create:
+                self.db.execute('BEGIN IMMEDIATE')
+                for sql in SCHEMA: self.db.execute(sql)
+                self.db.execute('PRAGMA user_version=1')
+                self.db.execute('COMMIT')
+                sync_dir(self.root)
+            self._validate()
+        except BaseException as e:
+            if self.db is not None: self.db.close()
+            if isinstance(e, Refused): raise
+            raise Refused('AUTHORITY_UNAVAILABLE') from None
+
+    def _path(self, p, directory=False):
+        no_symlink_ancestors(p)
+        for parent in p.parents:
+            a = parent.lstat()
+            sticky_root = a.st_uid == 0 and bool(a.st_mode & stat.S_ISVTX)
+            if a.st_uid not in (0,self.owner_uid) or a.st_mode & 0o022 and not sticky_root:
+                raise Refused('AUTHORITY_ANCESTOR')
+        s = p.lstat()
+        if (s.st_uid != self.owner_uid or stat.S_IMODE(s.st_mode) != (0o700 if directory else 0o600)
+                or not (stat.S_ISDIR(s.st_mode) if directory else stat.S_ISREG(s.st_mode))
+                or not directory and s.st_nlink != 1):
+            raise Refused('AUTHORITY_OWNERSHIP')
+
+    def _validate(self):
+        self._path(self.root, directory=True); self._path(self.path)
+        if self.path.stat().st_ino != self.inode: raise Refused('AUTHORITY_REPLACED')
+        if (self.db.execute('PRAGMA user_version').fetchone() != (1,)
+                or {x[0] for x in self.db.execute('SELECT sql FROM sqlite_master WHERE sql IS NOT NULL')} != set(SCHEMA)
+                or self.db.execute('PRAGMA integrity_check').fetchall() != [('ok',)]):
+            raise Refused('AUTHORITY_INTEGRITY')
+        prior = ZERO
+        events = []
+        for n,(seq,nonce,kind,raw,prev,seal) in enumerate(self.db.execute('SELECT * FROM events ORDER BY seq'),1):
+            value = strict_json(raw)
+            if (seq != n or prev != prior or canonical(value).decode() != raw
+                    or seal != digest(canonical([seq,nonce,kind,value,prev]))):
+                raise Refused('AUTHORITY_CHAIN')
+            events.append((kind,value)); prior = seal
+        return events, prior
+
+    def _state(self):
+        events, seal = self._validate()
+        root = None; accepted = []; checkpoint = None; terminal = False
+        permits = set(); sends = []; pending = None
+        for kind, data in events:
+            if kind == 'SUCCESSOR':
+                if root is not None or accepted or terminal: raise Refused('AUTHORITY_HISTORY')
+                root = data
+            elif kind == 'ACCEPT':
+                if root is None or terminal or len(accepted) >= 4: raise Refused('AUTHORITY_HISTORY')
+                n = len(accepted)+1
+                if (data['ordinal'] != n or data['transport'] != ('REST','REST','WS','WS')[n-1]
+                        or data['permit'] in permits): raise Refused('AUTHORITY_HISTORY')
+                accepted.append(data); permits.add(data['permit']); checkpoint = None
+            elif kind == 'CHECKPOINT':
+                if root is None or terminal or pending or data['accepted'] != len(accepted): raise Refused('AUTHORITY_HISTORY')
+                checkpoint = data
+            elif kind == 'SEND':
+                if (root is None or terminal or pending or not accepted
+                        or data['ordinal'] != len(accepted) or checkpoint is not None):
+                    raise Refused('AUTHORITY_HISTORY')
+                pending = data; sends.append(data)
+            elif kind == 'SETTLE':
+                if pending is None or data != pending: raise Refused('AUTHORITY_HISTORY')
+                pending = None
+            elif kind == 'TERMINAL':
+                if root is None or terminal: raise Refused('AUTHORITY_HISTORY')
+                terminal = True
+            else: raise Refused('AUTHORITY_HISTORY')
+        return {'seq':len(events),'seal':seal,'root':root,'accepted':accepted,
+                'checkpoint':checkpoint,'terminal':terminal,'sends':sends,'pending':pending}
+
+    def _identity(self):
+        # The reader must inspect root-owned release/config and supervised live
+        # invocation. Never substitute service-supplied strings for this reader.
+        if self.identity_reader() != self.authority.bindings.as_dict():
+            raise Refused('AUTHORITY_IDENTITY_DRIFT')
+
+    def _append(self, state, nonce, kind, data):
+        n = state['seq']+1
+        seal = digest(canonical([n,nonce,kind,data,state['seal']]))
+        self.db.execute('INSERT INTO events VALUES(?,?,?,?,?,?)',
+                        (n,nonce,kind,canonical(data).decode(),state['seal'],seal))
+        self.fault('before_commit')
+        self.db.execute('COMMIT')
+        self.fault('after_commit')
+        return {'seq':n,'seal':seal}
+
+    def _transaction(self, operation):
+        with self.lock:
+            try:
+                self.db.execute('BEGIN IMMEDIATE')
+                self._identity()
+                return operation(self._state())
+            except BaseException as e:
+                if self.db.in_transaction: self.db.execute('ROLLBACK')
+                if isinstance(e, (Refused, KeyboardInterrupt, SystemExit)): raise
+                raise Refused('AUTHORITY_TRANSACTION_REFUSED') from None
+
+    def signed(self, raw, signature, peer, verb):
+        if verb not in (SUCCESSOR_VERB,'AUTHORIZE_ONE','TERMINAL_STOP'):
+            raise Refused('AUTHORITY_VERB')
+        def op(state):
+            proof = self.predecessor_reader() if verb == SUCCESSOR_VERB else None
+            a = self.authority.check(raw,signature,peer,verb)
+            if self.db.execute('SELECT 1 FROM events WHERE nonce=?',(a['nonce'],)).fetchone():
+                raise Refused('AUTHORITY_REPLAY')
+            if verb == SUCCESSOR_VERB:
+                if state['root'] is not None: raise Refused('SUCCESSOR_ALREADY_RESERVED')
+                payload = successor_payload(proof,self.authority.bindings.as_dict())
+                if (a['payload'] != payload or a['checkpoint'] != digest(canonical(payload))
+                        or self.authority.bindings.epoch == proof.epoch):
+                    raise Refused('SUCCESSOR_SIGNED_BINDING')
+                # Re-read at both sides of signature verification, just as 6G.
+                if self.predecessor_reader() != proof: raise Refused('PREDECESSOR_CHANGED')
+                kind, data = 'SUCCESSOR', payload
+            else:
+                if state['root'] is None or state['terminal']: raise Refused('AUTHORITY_CLOSED')
+                cp = state['checkpoint']
+                if cp is None or a['checkpoint'] != cp['digest']: raise Refused('AUTHORITY_CHECKPOINT')
+                if verb == 'TERMINAL_STOP':
+                    kind, data = 'TERMINAL', {'accepted':len(state['accepted'])}
+                else:
+                    n = len(state['accepted'])+1; p = a['payload']
+                    if (n > 4 or p['transport'] != ('REST','REST','WS','WS')[n-1]
+                            or type(p['session']) is not str or not 1 <= len(p['session']) <= 128
+                            or type(p['request_commitment']) is not str or len(p['request_commitment']) != 64
+                            or any(c not in '0123456789abcdef' for c in p['request_commitment'])):
+                        raise Refused('AUTHORITY_PERMIT')
+                    if any(x['transport']==p['transport'] and x['session']!=p['session'] for x in state['accepted']):
+                        raise Refused('AUTHORITY_SESSION')
+                    kind, data = 'ACCEPT', {'ordinal':n,'transport':p['transport'],'session':p['session'],
+                                          'commitment':p['request_commitment'],'permit':a['nonce']}
+            self._identity()
+            if not self.authority.clock() < a['expires']: raise Refused('CONTROL_EXPIRED')
+            return self._append(state,a['nonce'],kind,data)
+        return self._transaction(op)
+
+    def checkpoint(self, *, peer, expected, snapshot_reader):
+        """Trusted helper-side fixed-path snapshot reader; never a wire callback.
+
+        Snapshot = {accepted:[exact reservation rows], digest:coordinated hash,
+        clean:True}. Incomplete/unknown resource state cannot advance authority.
+        """
+        self._service_peer(peer)
+        def op(state):
+            if (state['root'] is None or state['terminal'] or state['pending']
+                    or expected != {'seq':state['seq'],'seal':state['seal']}):
+                raise Refused('AUTHORITY_STALE_STATE')
+            snap = snapshot_reader()
+            if (type(snap) is not dict or set(snap) != {'accepted','digest','clean'}
+                    or snap['clean'] is not True or snap['accepted'] != state['accepted']
+                    or type(snap['digest']) is not str or len(snap['digest']) != 64
+                    or any(c not in '0123456789abcdef' for c in snap['digest'])):
+                raise Refused('AUTHORITY_SNAPSHOT')
+            self._identity()
+            data = {'accepted':len(state['accepted']),'digest':snap['digest']}
+            # Checkpoints are internal fixed-schema transactions, never signers.
+            return self._append(state,'checkpoint-'+str(state['seq']+1),'CHECKPOINT',data)
+        return self._transaction(op)
+
+    def _service_peer(self, peer):
+        if (type(peer) is not tuple or len(peer)!=2 or type(peer[0]) is not int
+                or peer[0] != self.service_uid or type(peer[1]) is not int or peer[1]<=0):
+            raise Refused('AUTHORITY_SERVICE_PEER')
+
+    def possible_send(self, *, peer, expected, ordinal, role, request_digest):
+        """Burn a protected substep intent BEFORE transport, without proxying it.
+
+        Lost acknowledgements stay uncertain. No retry, refund or expiry cleanup.
+        Resource bindings must come from the protected approved configuration.
+        """
+        self._service_peer(peer)
+        def op(state):
+            if (state['root'] is None or state['terminal'] or state['pending'] or state['checkpoint'] is not None
+                    or type(ordinal) is not int or ordinal != len(state['accepted']) or not 1<=ordinal<=4
+                    or expected != {'seq':state['seq'],'seal':state['seal']}):
+                raise Refused('AUTHORITY_SEND_STATE')
+            prior = [x['role'] for x in state['sends'] if x['ordinal']==ordinal]
+            responders = ('legacy_trivial','legacy_normal')
+            allowed = ('legacy_router',*responders) if not prior else responders if prior[-1]=='legacy_router' else ('granite',) if prior[-1] in responders else ()
+            if (type(role) is not str or role not in allowed or role not in self.provider_resources
+                    or type(request_digest) is not str or len(request_digest)!=64
+                    or any(c not in '0123456789abcdef' for c in request_digest)):
+                raise Refused('AUTHORITY_SEND_BINDING')
+            resource = self.provider_resources[role]
+            if type(resource) is not str or len(resource)!=64 or any(c not in '0123456789abcdef' for c in resource):
+                raise Refused('AUTHORITY_RESOURCE_UNQUALIFIED')
+            data = {'ordinal':ordinal,'role':role,'resource':resource,
+                    'request':request_digest,'send_seq':state['seq']+1}
+            return self._append(state,'send-'+str(state['seq']+1),'SEND',data)
+        return self._transaction(op)
+
+    def settle(self, *, peer, expected, terminal_reader):
+        """Only a protected independent terminal-evidence reader can settle.
+
+        A complete native response supplied by the compromised service is NOT an
+        independent reader. No production implementation of this reader exists.
+        """
+        self._service_peer(peer)
+        def op(state):
+            if (state['pending'] is None or state['terminal']
+                    or expected != {'seq':state['seq'],'seal':state['seal']}):
+                raise Refused('AUTHORITY_SETTLE_STATE')
+            proof = terminal_reader()
+            if (type(proof) is not dict or set(proof)!={'terminal','association'}
+                    or proof['terminal'] is not True or proof['association'] != state['pending']):
+                raise Refused('AUTHORITY_REMOTE_UNKNOWN')
+            self._identity()
+            return self._append(state,'settle-'+str(state['seq']+1),'SETTLE',state['pending'])
+        return self._transaction(op)
+
+    def read(self):
+        with self.lock:
+            try:
+                self.db.execute('BEGIN')
+                self._identity(); value = self._state()
+                self.db.execute('COMMIT')
+                return value
+            except BaseException as e:
+                if self.db.in_transaction: self.db.execute('ROLLBACK')
+                if isinstance(e,Refused): raise
+                raise Refused('AUTHORITY_UNAVAILABLE') from None
+
+    def reconcile(self, *, seq, seal):
+        s = self.read()
+        if type(seq) is not int or (seq,seal) != (s['seq'],s['seal']):
+            raise Refused('AUTHORITY_ROLLBACK_OR_INCOMPLETE')
+        return s
+
+    def close(self): self.db.close()
