+@pytest.mark.parametrize('attack',['symlink','hardlink','mode','owner','missing','corrupt','schema','chain'])
+def test_filesystem_and_incomplete_authority_refuse(f,tmp_path,attack):
+    p=f.journal.path
+    if attack=='symlink':
+        q=tmp_path/'link';q.symlink_to(f.root,target_is_directory=True)
+        with pytest.raises(Refused):
+            ProtectedJournal(q,owner_uid=os.getuid(),service_uid=os.getuid(),authority=f.authority,
+                             predecessor_reader=lambda:f.proof,identity_reader=lambda:f.identity)
+        return
+    if attack=='hardlink': os.link(p,tmp_path/'hard')
+    elif attack=='mode': p.chmod(0o644)
+    elif attack=='owner': f.journal.owner_uid=os.getuid()+1
+    elif attack=='missing': p.unlink()
+    elif attack=='corrupt':
+        f.journal.close();p.write_bytes(b'not sqlite')
+        with pytest.raises(Refused):f.open()
+        return
+    elif attack=='schema': f.journal.db.execute('DROP TRIGGER no_update')
+    elif attack=='chain':
+        f.successor();f.journal.db.execute('DROP TRIGGER no_update')
+        f.journal.db.execute("UPDATE events SET seal=?",('f'*64,))
+        f.journal.db.execute("CREATE TRIGGER no_update BEFORE UPDATE ON events BEGIN SELECT RAISE(ABORT,'IMMUTABLE'); END")
+    with pytest.raises(Refused): f.journal.read()
