+def test_concurrent_successors_two_database_connections(f):
+    other=f.open(); packets=[f.envelope(SUCCESSOR_VERB),f.envelope(SUCCESSOR_VERB)]
+    barrier=threading.Barrier(2)
+    def run(pair):
+        journal,packet=pair;barrier.wait()
+        try:f.send(packet,journal=journal);return 'accepted'
+        except Refused:return 'refused'
+    try:
+        with ThreadPoolExecutor(2) as pool:
+            assert sorted(pool.map(run,zip([f.journal,other],packets)))==['accepted','refused']
+        assert f.journal.read()['seq']==1
+    finally:other.close()
