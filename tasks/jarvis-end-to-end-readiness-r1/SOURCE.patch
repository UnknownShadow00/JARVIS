+EXEC_KEY=b'synthetic-v6-independent-operator-000000000000'
+REQUEST_KEY=b'synthetic-v6-request-signing-key-00000000000'
+RESPONSE_KEY=b'synthetic-v6-response-signing-key-0000000000'
