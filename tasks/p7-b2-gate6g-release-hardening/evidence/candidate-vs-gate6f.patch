+"""Read-only transition checks. A protected reader/root is still a release requirement.
+
+No service control, credentials, network or production writes. Re-run at signing;
+an archive-only proof cannot authorize a successor. Do not log file contents.
+"""
+from dataclasses import replace
+from pathlib import Path
+import sqlite3
+
+from .contracts import Refused, canonical, digest, strict_json
+from .lineage import validate_v2_archive
+from .storage import no_symlink_ancestors
+
+
+def logical_controller_digest(path):
+    path = Path(path)
+    no_symlink_ancestors(path)
+    db = sqlite3.connect(path.as_uri() + '?mode=ro', uri=True, timeout=1)
+    try:
+        db.execute('PRAGMA query_only=ON')
+        db.execute('BEGIN')
+        if db.execute('PRAGMA quick_check').fetchall() != [('ok',)]:
+            raise Refused('PREDECESSOR_DATABASE')
+        schema = db.execute('SELECT type,name,tbl_name,sql FROM sqlite_master ORDER BY type,name').fetchall()
+        tables = {}
+        for kind, name, _, _ in schema:
+            if kind != 'table':
+                continue
+            rows = db.execute('SELECT * FROM "' + name.replace('"', '""') + '"').fetchall()
+            # Preserve SQLite types, including BLOBs, without depending on row order.
+            typed = [[['blob', x.hex()] if isinstance(x, bytes) else [type(x).__name__, x]
+                      for x in row] for row in rows]
+            tables[name] = sorted(typed, key=canonical)
+        return digest(canonical({'schema': schema, 'tables': tables,
