+            if mutation=='config':(reader.source_root/'config.yaml').write_text('changed: true\n')
+            elif mutation=='source':
+                p = reader.source_root/'app/execution'/next(iter(reader.hashes))
+                p.write_bytes(p.read_bytes()+b'\n# changed\n')
+            elif mutation=='archive':
