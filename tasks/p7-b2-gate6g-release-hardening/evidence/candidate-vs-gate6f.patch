+"""Synthetic signing/reader fixtures only; never attest a real predecessor."""
+from dataclasses import replace
+import hmac
+import uuid
+from candidate_v3.authority import Authority, SUCCESSOR_VERB
+from candidate_v3.contracts import Bindings, canonical, digest
+from candidate_v3.lineage import successor_payload
+
+
+def fresh_fixture_proof(proof):
+    return replace(proof, config_digest='c'*64, controller_digest='d'*64,
+                   live_state_digest='e'*64)
+
+
+def signed_fixture(proof, bindings):
+    from tests.execution.v3_candidate_test import KEY, Signer
+    payload = successor_payload(proof, bindings)
+    raw = canonical(dict(verb=SUCCESSOR_VERB, nonce=uuid.uuid4().hex, expires=130.,
+                         bindings=bindings, checkpoint=digest(canonical(payload)), payload=payload))
+    return Authority(Bindings(**bindings), Signer(), clock=lambda:100., operator_id='dummy-human'), raw, hmac.digest(KEY, raw, 'sha256')
+
+
+def reserve_fixture(high, proof, bindings, *, authority=None):
+    """Explicit synthetic revalidation replaces the old unconditional True seam."""
+    verifier, raw, signature = signed_fixture(proof, bindings)
+    high.reserve_successor(proof, bindings, authority=verifier if authority is None else authority,
+                           raw=raw, signature=signature, peer=(0,99), revalidate=lambda:proof)
+    return successor_payload(proof, bindings)
