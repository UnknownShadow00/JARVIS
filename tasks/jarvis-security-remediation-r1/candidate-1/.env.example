# JARVIS — Docker Compose environment
# Copy to .env and fill in values. Never commit .env.

# Neo4j password for the Graphiti temporal graph store (neo4j service).
# Used as NEO4J_AUTH=neo4j/<password> in docker-compose.yml.
NEO4J_PASSWORD=

# Bearer token for the JARVIS API (server.api_token override).
# Empty = auth disabled (localhost-only use).
# REQUIRED before any Tailscale/remote exposure — tools include shell and file access.
JARVIS_API_TOKEN=
