+"""Offline model tests: disposable SQLite only, no production imports or clients."""
+from dataclasses import replace, fields
+import itertools
+import sqlite3
+import threading
+import unittest
+from design_model import Binding, Grant, Model, Refused
+
+
+def fixture():
+    db = sqlite3.connect(':memory:', check_same_thread=False)
+    return Model(db, create=True)
+
+
+def initial(m):
+    return Grant('dummy-open', m.binding)
+
+
+def arm(m, index=None):
+    index = m.accepted if index is None else index
+    return Grant('dummy-arm-' + str(index), m.binding, action='ARM_NEXT')
+
+
+class DesignTests(unittest.TestCase):
+    def test_fresh_closed_no_fake_acceptance(self):
+        m = fixture()
+        self.assertFalse(m.accept('http'))
+        self.assertEqual((m.state, m.accepted, m.fake_transmissions), ('CLOSED', 0, 0))
+
+    def test_valid_open_no_generation_lease_or_acceptance(self):
+        m = fixture();m.open(initial(m))
+        self.assertEqual((m.state,m.d06,m.accepted,m.fake_transmissions), ('HOLD','CLEAN',0,0))
+        self.assertFalse(m.accept('http'))
+
+    def test_exact_four_and_two_each_no_automatic_next(self):
+        m = fixture();m.open(initial(m))
+        for transport in m.sequence:
+            m.arm(arm(m),transport)
+            self.assertTrue(m.accept(transport))
+            m.transmit_fake();m.complete()
+            self.assertFalse(m.accept(transport))
+        self.assertEqual(m.accepted,4)
+        self.assertEqual(m.fake_transmissions,4)
+        self.assertEqual(m.state,'TERMINAL')
+        self.assertEqual(m.db.execute('SELECT transport,count(*) FROM attempts GROUP BY transport').fetchall(), [('http',2),('websocket',2)])
+        self.assertEqual(m.db.execute('SELECT DISTINCT origin,eligible FROM attempts').fetchall(), [('LIVE',0)])
+        self.assertEqual((m.tool_dispatches,m.legacy_calls),(0,0))
+
+    def test_repeated_open_refused_without_mutation(self):
+        m=fixture();m.open(initial(m));s=m.snapshot()
+        with self.assertRaises(Refused):m.open(initial(m))
+        self.assertEqual(s,m.snapshot())
+
+    def test_accepted_attempt_blocks_initial_open_after_restart(self):
+        m=fixture();m.open(initial(m));m.arm(arm(m),'http');m.accept('http');m.complete()
+        restarted=Model(m.db,binding=replace(m.binding,pid=12346,runtime_nonce='new'))
+        with self.assertRaises(Refused):restarted.open(initial(restarted))
+        self.assertEqual((restarted.state,restarted.accepted),('RECOVERY_HOLD',1))
+
+    def test_separate_recovery_preserves_high_water_quota_and_eligibility(self):
+        m=fixture();m.open(initial(m))
+        for _ in range(2):m.arm(arm(m),'http');m.accept('http');m.complete()
+        r=Model(m.db,binding=replace(m.binding,pid=12346,runtime_nonce='new'))
+        self.assertFalse(r.accept('websocket'))
+        r.open(Grant('dummy-recovery',r.binding,action='RECOVER'),recovery=True)
+        with self.assertRaises(Refused):r.arm(arm(r),'http')
+        for _ in range(2):r.arm(arm(r),'websocket');r.accept('websocket');r.complete()
+        self.assertEqual(r.accepted,4)
+
+    def test_crash_after_acceptance_preserves_unknown_and_blocks_recovery(self):
+        m=fixture();m.open(initial(m));m.arm(arm(m),'http');m.accept('http');m.transmit_fake()
+        r=Model(m.db,binding=replace(m.binding,pid=12346),d06_state=m.d06)
+        with self.assertRaises(Refused):r.open(Grant('recovery',r.binding,action='RECOVER'),recovery=True)
+        self.assertEqual((r.accepted,r.d06), (1,'ACTIVE'))
+
+    def test_crash_after_open_commit_spends_nonce_but_never_autoopens(self):
+        m=fixture()
+        with self.assertRaises(Refused):m.open(initial(m),fault='after_commit')
+        r=Model(m.db)
+        self.assertEqual(r.state,'RECOVERY_HOLD')
+        self.assertFalse(r.accept('http'))
+        self.assertEqual(r.db.execute('SELECT nonce FROM grants').fetchall(), [('dummy-open',)])
+        with self.assertRaises(Refused):r.open(initial(r))
+
+    def test_partial_write_rolls_back_durable_open(self):
+        m=fixture()
+        with self.assertRaises(Refused):m.open(initial(m),fault='before_commit')
+        self.assertEqual(m.db.execute('SELECT opened FROM control').fetchone(), (0,))
+        self.assertEqual(m.db.execute('SELECT count(*) FROM grants').fetchone(), (0,))
+        self.assertEqual(m.state,'CLOSED')
+
+    def test_stop_irreversible_even_with_new_operator_grant(self):
+        m=fixture();m.open(initial(m));m.stop()
+        r=Model(m.db)
+        for action in ('OPEN_INITIAL','RECOVER'):
+            with self.assertRaises(Refused):r.open(Grant(action,r.binding,action=action),recovery=action=='RECOVER')
+        self.assertEqual(r.state,'TERMINAL')
+
+    def test_recovery_never_reuses_an_old_runtime_grant(self):
+        m=fixture();m.open(initial(m));r=Model(m.db,binding=replace(m.binding,invocation='new'))
+        with self.assertRaises(Refused):r.open(Grant('recover',m.binding,action='RECOVER'),recovery=True)
+
+    def test_cap_enforced_after_restart(self):
+        m=fixture();m.open(initial(m))
+        for t in m.sequence:m.arm(arm(m),t);m.accept(t);m.complete()
+        r=Model(m.db)
+        with self.assertRaises(Refused):r.open(Grant('recover',r.binding,action='RECOVER'),recovery=True)
+        self.assertEqual(r.accepted,4)
+
+    def test_concurrent_rest_ws_reserves_at_most_one_no_queue(self):
+        m=fixture();m.open(initial(m));m.arm(arm(m),'http')
+        barrier=threading.Barrier(3);results=[]
+        def offer(t):barrier.wait();results.append(m.accept(t))
+        threads=[threading.Thread(target=offer,args=(t,)) for t in ('http','websocket')]
+        for t in threads:t.start()
+        barrier.wait()
+        for t in threads:t.join(2);self.assertFalse(t.is_alive())
+        self.assertLessEqual(sum(results),1)
+        self.assertLessEqual(m.accepted,1)
+        self.assertEqual(m.state,'TERMINAL')
+
+    def test_tool_proposal_never_dispatches_and_blocks_next(self):
+        m=fixture();m.open(initial(m));m.arm(arm(m),'http');m.accept('http');m.transmit_fake();m.complete(tool_proposal=True)
+        self.assertEqual((m.state,m.tool_dispatches),('TERMINAL',0))
+        with self.assertRaises(Refused):m.arm(arm(m),'http')
+
+    def test_unknown_never_inferred_complete_or_released(self):
+        m=fixture();m.open(initial(m));m.arm(arm(m),'http');m.accept('http');m.transmit_fake();m.complete(known_terminal=False)
+        self.assertEqual((m.state,m.d06),('TERMINAL','UNKNOWN'))
+        self.assertEqual(m.db.execute('SELECT status FROM attempts').fetchone(),('INFLIGHT',))
+
+    def test_backup_failure_preserves_accepted_and_stops_next(self):
+        m=fixture();m.open(initial(m));m.arm(arm(m),'http');m.accept('http');m.complete(backup_ok=False)
+        self.assertEqual((m.accepted,m.state), (1,'TERMINAL'))
+        with self.assertRaises(Refused):m.arm(arm(m),'http')
+
+    def test_receipt_join_failure_stops_next(self):
+        m=fixture();m.open(initial(m));m.arm(arm(m),'http');m.accept('http');m.complete(receipt_valid=False)
+        self.assertEqual((m.accepted,m.state), (1,'TERMINAL'))
+
+    def test_missing_control_refuses_startup(self):
+        m=fixture();m.db.execute('DELETE FROM control');m.db.commit()
+        with self.assertRaises(Refused):Model(m.db)
+
+    def test_corrupt_control_refuses_startup(self):
+        m=fixture();m.db.execute('UPDATE control SET opened=99');m.db.commit()
+        with self.assertRaises(Refused):Model(m.db)
+
+    def test_missing_database_is_not_initialized_on_restart(self):
+        with self.assertRaises(Refused):Model(sqlite3.connect(':memory:'))
+
+    def test_existing_accepted_set_cannot_be_hidden_by_transition(self):
+        with self.assertRaises(Refused):Model(sqlite3.connect(':memory:'),create=True,legacy_count=1)
+
+    def test_same_legacy_epoch_cannot_be_relabeled_successor(self):
+        with self.assertRaises(Refused):Model(sqlite3.connect(':memory:'),create=True,binding=replace(Binding(),epoch=Binding().predecessor))
+
+    def test_permit_replay_refused(self):
+        m=fixture();m.open(initial(m));g=arm(m);m.arm(g,'http');m.accept('http');m.complete()
+        with self.assertRaises(Refused):m.arm(g,'http')
+
+    def test_zero_existing_accepted_backup_does_not_authorize_open(self):
+        m=fixture()
+        with self.assertRaises(Refused):m.open(Grant('unapproved',m.binding,operator_verified=False))
+        self.assertEqual(m.accepted,0)
+
+    def test_runtime_prerequisites_rechecked_before_acceptance(self):
+        for attribute,value in [('d06','ACTIVE'),('endpoint_exclusive',False),('control_valid',False),('backup_valid',False)]:
+            with self.subTest(attribute=attribute):
+                m=fixture();m.open(initial(m));m.arm(arm(m),'http');setattr(m,attribute,value)
+                self.assertFalse(m.accept('http'));self.assertEqual(m.accepted,0)
+
+    def test_bounded_event_sequences_preserve_core_invariants(self):
+        for actions in itertools.product(('open','arm','accept','complete','stop'),repeat=4):
+            m=fixture();previous=0
+            for action in actions:
+                try:
+                    if action=='open':m.open(initial(m))
+                    elif action=='arm':m.arm(arm(m),m.sequence[min(m.accepted,3)])
+                    elif action=='accept':m.accept('http')
+                    elif action=='complete':m.complete()
+                    else:m.stop()
+                except Refused:pass
+                self.assertGreaterEqual(m.accepted,previous);previous=m.accepted
+                self.assertLessEqual(m.accepted,4)
+                self.assertEqual((m.tool_dispatches,m.legacy_calls),(0,0))
+            m.db.close()
+
+
+def binding_test(field):
+    def test(self):
+        m=fixture();v=getattr(m.binding,field);wrong=v+1 if isinstance(v,int) else v+'-WRONG'
+        with self.assertRaises(Refused):m.open(Grant('wrong-'+field,replace(m.binding,**{field:wrong})))
+        self.assertEqual((m.state,m.accepted),('CLOSED',0))
+    return test
+
+
+for field in fields(Binding):setattr(DesignTests,'test_wrong_binding_'+field.name,binding_test(field.name))
+
+
+def guard_test(attribute,value):
+    def test(self):
+        m=fixture();setattr(m,attribute,value)
+        with self.assertRaises(Refused):m.open(initial(m))
+        self.assertEqual(m.accepted,0)
+    return test
+
+
+for label,attribute,value in [('d06_active','d06','ACTIVE'),('d06_unknown','d06','UNKNOWN'),('backup_invalid','backup_valid',False),('control_corrupt','control_valid',False),('endpoint_conflict','endpoint_exclusive',False)]:
+    setattr(DesignTests,'test_refuse_'+label,guard_test(attribute,value))
+
+
+def grant_test(field,value):
+    def test(self):
+        m=fixture()
+        with self.assertRaises(Refused):m.open(replace(initial(m),**{field:value}))
+    return test
+
+
+for label,field,value in [('same_uid_agent','peer_uid',1000),('untrusted_uid','peer_uid',4567),('wrong_dummy_operator_credential','operator_verified',False),('expired','expired',True),('wrong_action','action','ARM_NEXT')]:
+    setattr(DesignTests,'test_refuse_'+label,grant_test(field,value))
+
+
+def ingress_test(transport,kw):
+    def test(self):
+        m=fixture();m.open(initial(m));m.arm(arm(m),'http')
+        self.assertFalse(m.accept(transport,**kw))
+        self.assertEqual((m.accepted,m.fake_transmissions,m.tool_dispatches),(0,0,0))
+    return test
+
+
+for label,transport,kw in [('voice','voice',{}),('direct','direct',{}),('wrong_scope','http',{'scope':'wrong'}),('untrusted_client','http',{'client':'wrong'}),('wrong_dummy_api_credential','http',{'authenticated':False})]:
+    setattr(DesignTests,'test_ingress_refuse_'+label,ingress_test(transport,kw))
+
+
+if __name__ == '__main__':unittest.main(verbosity=2)
