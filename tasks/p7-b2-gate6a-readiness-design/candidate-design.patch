+"""DISPOSABLE DESIGN MODEL, not an opener, service module, or credential client.
+
+Root-peer and operator-auth checks below are supplied fixture facts, not actual
+SO_PEERCRED, PAM, FIDO or signature verification. No network or JARVIS imports.
+"""
+from dataclasses import dataclass
+import sqlite3
+import threading
+
+
+class Refused(Exception):
+    pass
+
+
+@dataclass(frozen=True)
+class Binding:
+    source: str = 'dummy-reviewed-source'
+    config: str = 'dummy-reviewed-config'
+    epoch: str = 'dummy-successor-epoch'
+    predecessor: str = 'dummy-retained-v2-epoch'
+    pid: int = 12345
+    invocation: str = 'dummy-invocation'
+    boot: str = 'dummy-boot'
+    start_tick: int = 700
+    runtime_nonce: str = 'dummy-runtime-challenge'
+    resource: str = 'dummy-endpoint-qualified-resource'
+    profile: str = 'dummy-native-profile'
+    checkpoint: str = 'dummy-verified-checkpoint'
+    contract: str = 'dummy-contract-v3'
+    gate5: str = 'dummy-renewed-gate5-seal'
+
+
+@dataclass(frozen=True)
+class Grant:
+    nonce: str
+    binding: Binding
+    action: str = 'OPEN_INITIAL'
+    peer_uid: int = 0
+    operator_verified: bool = True
+    expired: bool = False
+
+
+class Model:
+    sequence = ('http', 'http', 'websocket', 'websocket')
+
+    def __init__(self, db, *, create=False, binding=Binding(), legacy_count=0, d06_state='CLEAN'):
+        self.db, self.binding = db, binding
+        self.lock = threading.Lock()
+        self.d06 = d06_state  # Independent fixture fact, not inferred from D09.
+        self.backup_valid = True
+        self.endpoint_exclusive = True
+        self.control_valid = True
+        self.fake_transmissions = self.tool_dispatches = self.legacy_calls = 0
+        self.permit = None
+        self.state = 'CLOSED'
+        if create:
+            # Fixture provisioning only: production migration is NOT implemented.
+            if legacy_count or binding.epoch == binding.predecessor:
+                raise Refused('UNAPPROVED_OR_NONZERO_LEGACY_TRANSITION')
+            db.executescript('''
+CREATE TABLE predecessor (id TEXT PRIMARY KEY, accepted INTEGER NOT NULL CHECK(accepted=0), status TEXT NOT NULL CHECK(status='CLOSED_COMPLETE'));
+CREATE TABLE control (id INTEGER PRIMARY KEY CHECK(id=1), opened INTEGER NOT NULL, terminal TEXT, backup_count INTEGER NOT NULL);
+CREATE TABLE grants (nonce TEXT PRIMARY KEY, action TEXT NOT NULL);
+CREATE TABLE attempts (ordinal INTEGER PRIMARY KEY CHECK(ordinal BETWEEN 1 AND 4), transport TEXT NOT NULL, status TEXT NOT NULL, origin TEXT NOT NULL CHECK(origin='LIVE'), eligible INTEGER NOT NULL CHECK(eligible=0));
+''')
+            db.execute('INSERT INTO predecessor VALUES (?,0,?)', (binding.predecessor, 'CLOSED_COMPLETE'))
+            db.execute('INSERT INTO control VALUES (1,0,NULL,0)')
+            db.commit()
+        try:
+            if db.execute('PRAGMA integrity_check').fetchall() != [('ok',)]:
+                raise Refused('CORRUPT')
+            if db.execute('SELECT id,accepted,status FROM predecessor').fetchall() != [(binding.predecessor, 0, 'CLOSED_COMPLETE')]:
+                raise Refused('LINEAGE')
+            row = db.execute('SELECT opened,terminal,backup_count FROM control WHERE id=1').fetchone()
+            if row is None or row[0] not in (0, 1) or row[2] > self.accepted:
+                raise Refused('CONTROL')
+            if row[1] is not None:
+                self.state = 'TERMINAL'
+            elif row[0]:
+                self.state = 'RECOVERY_HOLD'
+            # Unresolved accepted rows independently block recovery below.
+            # Never fabricate or clear a D06 state from controller/runner absence.
+        except sqlite3.Error as e:
+            raise Refused('MISSING_OR_CORRUPT_STATE') from None
+
+    @property
+    def accepted(self):
+        return self.db.execute('SELECT count(*) FROM attempts').fetchone()[0]
+
+    def _require(self, condition, code):
+        if not condition:
+            raise Refused(code)
+
+    def _prerequisites(self, grant, action):
+        self._require(grant.peer_uid == 0 and grant.operator_verified, 'OPERATOR_AUTHORITY')
+        self._require(grant.binding == self.binding and not grant.expired and grant.action == action, 'BINDING')
+        self._require(self.control_valid, 'CONTROL_STATE')
+        self._require(self.d06 == 'CLEAN' and self.endpoint_exclusive, 'OWNERSHIP_OR_ENDPOINT')
+        row = self.db.execute('SELECT terminal,backup_count FROM control').fetchone()
+        self._require(row[0] is None and self.backup_valid and row[1] == self.accepted, 'TERMINAL_OR_BACKUP')
+        self._require(not self.db.execute('SELECT 1 FROM attempts WHERE status!=?', ('COMMITTED',)).fetchone(), 'UNRESOLVED_ACCEPTANCE')
+
+    def _spend(self, grant):
+        try:
+            self.db.execute('INSERT INTO grants VALUES (?,?)', (grant.nonce, grant.action))
+        except sqlite3.IntegrityError:
+            raise Refused('REPLAY') from None
+
+    def open(self, grant, *, recovery=False, fault=None):
+        action = 'RECOVER' if recovery else 'OPEN_INITIAL'
+        self._prerequisites(grant, action)
+        self._require(self.state == ('RECOVERY_HOLD' if recovery else 'CLOSED'), 'RUNTIME_STATE')
+        if not recovery:
+            self._require(self.accepted == 0 and self.db.execute('SELECT opened FROM control').fetchone()[0] == 0, 'INITIAL_ZERO_ONLY')
+        self._require(self.accepted < 4, 'CAP')
+        with self.db:
+            self._spend(grant)
+            self.db.execute('UPDATE control SET opened=1')
+            if fault == 'before_commit':
+                raise Refused('INJECTED_PARTIAL_WRITE')
+        # Durable grant consumption never restores a runnable OPEN state.
+        if fault == 'after_commit':
+            raise Refused('INJECTED_CRASH_BEFORE_RUNTIME_RELEASE')
+        self.state = 'HOLD'
+
+    def arm(self, grant, transport, *, client='dummy-approved-session', scope='dummy-pilot-scope'):
+        self._prerequisites(grant, 'ARM_NEXT')
+        self._require(self.state == 'HOLD' and self.accepted < 4, 'HOLD_OR_CAP')
+        self._require(transport == self.sequence[self.accepted], 'TRANSPORT_QUOTA')
+        with self.db:
+            self._spend(grant)
+        self.permit = (transport, client, scope)
+        self.state = 'ARMED'
+
+    def accept(self, transport, *, authenticated=True, client='dummy-approved-session', scope='dummy-pilot-scope'):
+        with self.lock:
+            if self.state == 'INFLIGHT':
+                self.stop('CONCURRENT_INTAKE')
+                return False
+            if self.state != 'ARMED':
+                return False
+            if not authenticated or self.permit != (transport, client, scope):
+                self.stop('AUTH_OR_SCOPE')
+                return False
+            if self.d06 != 'CLEAN' or not self.endpoint_exclusive or not self.control_valid or not self.backup_valid:
+                self.stop('PREREQUISITE_CHANGED')
+                return False
+            with self.db:
+                self.db.execute('INSERT INTO attempts VALUES (?,?,?,\'LIVE\',0)',
+                                (self.accepted + 1, transport, 'INFLIGHT'))
+            self.permit = None
+            self.state = 'INFLIGHT'
+            return True
+
+    def transmit_fake(self):
+        self._require(self.state == 'INFLIGHT' and self.d06 == 'CLEAN', 'NO_ACTIVE_ATTEMPT')
+        self.d06 = 'ACTIVE'
+        self.fake_transmissions += 1
+
+    def complete(self, *, known_terminal=True, receipt_valid=True, tool_proposal=False, backup_ok=True):
+        self._require(self.db.execute('SELECT 1 FROM attempts WHERE status=\'INFLIGHT\'').fetchone() is not None, 'NO_PENDING')
+        if not known_terminal:
+            self.d06 = 'UNKNOWN'
+            self.stop('REMOTE_UNKNOWN')
+            return
+        self.d06 = 'CLEAN'
+        terminal = 'COMMITTED' if receipt_valid and not tool_proposal else 'FAILED'
+        with self.db:
+            self.db.execute('UPDATE attempts SET status=? WHERE status=\'INFLIGHT\'', (terminal,))
+        if terminal != 'COMMITTED':
+            self.stop('TOOL_OR_RECEIPT_FAILURE')
+            return
+        if not backup_ok:
+            self.backup_valid = False
+            self.stop('BACKUP_FAILURE')
+            return
+        with self.db:
+            self.db.execute('UPDATE control SET backup_count=?', (self.accepted,))
+        if self.state != 'TERMINAL':
+            self.state = 'HOLD'
+        if self.accepted == 4:
+            self.stop('CAP_REACHED')
+
+    def stop(self, reason='OPERATOR_STOP'):
+        self.permit = None
+        self.state = 'TERMINAL'
+        with self.db:
+            self.db.execute('UPDATE control SET terminal=COALESCE(terminal,?)', (reason,))
+
+    def snapshot(self):
+        return (self.accepted, tuple(self.db.execute('SELECT * FROM attempts ORDER BY ordinal')),
+                tuple(self.db.execute('SELECT * FROM grants ORDER BY nonce')))
