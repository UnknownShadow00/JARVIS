+  p=Path(os.fsdecode(a[0])).absolute()
+  if str(p).startswith(('/home/jarvis/JARVIS','/home/jarvis/.config','/proc/')):
+   counts['secret_or_production']+=1;raise RuntimeError('PRODUCTION_FORBIDDEN')
+  if (a[2] or 0)&(os.O_WRONLY|os.O_RDWR|os.O_CREAT|os.O_TRUNC|os.O_APPEND) and ROOT not in p.parents:
+   counts['external_write']+=1;raise RuntimeError('EXTERNAL_WRITE_FORBIDDEN')
+sys.addaudithook(guard)
+start=time.monotonic();suite=unittest.defaultTestLoader.discover(str(ROOT),pattern='test_design.py')
+with (ROOT/'design-tests.txt').open('w') as stream:result=unittest.TextTestRunner(stream=stream,verbosity=2).run(suite)
+summary={'tests':result.testsRun,'failures':len(result.failures),'errors':len(result.errors),'seconds':time.monotonic()-start,'guards':counts,'model_not_production':True,'limitations':['dummy authority and access policy, not OS enforcement','SQLite logical crash points, not power-loss/fsync qualification','fake legacy/Granite outputs, not production equivalence']}
+(ROOT/'design-test-results.json').write_text(json.dumps(summary,indent=2)+'\n');print(json.dumps(summary));sys.exit(not result.wasSuccessful())
