+import os,sys,json,unittest,time
+from pathlib import Path
+sys.dont_write_bytecode=True
+ROOT=Path(__file__).parent.resolve();counts={'network':0,'secret_or_production':0,'external_write':0,'execution':0}
+def guard(ev,a):
+ if ev.startswith('socket.'):
+  counts['network']+=1;raise RuntimeError('NETWORK_FORBIDDEN')
+ if ev in ('subprocess.Popen','os.system','os.exec','os.posix_spawn'):
+  counts['execution']+=1;raise RuntimeError('EXECUTION_FORBIDDEN')
