+"""Nondeployable Gate6B model. Dummy authority, fake providers, disposable SQLite only."""
+import sqlite3, threading
+from contextlib import contextmanager
+
+class Refused(Exception): pass
+class Crash(Exception): pass
+
+class Ledger:
+ def __init__(self, path, create=False):
+  self.db=sqlite3.connect(path,timeout=0,check_same_thread=False,isolation_level=None)
+  self.lock=threading.Lock(); self.runtime='CLOSED'; self.binding=('source','config','release','pid','invocation','epoch')
+  self.d06=None;self.checkpoint=True;self.conflict=False;self.sends=[];self.tools=0;self.lifecycle=0;self.visible=[];self.history=[]
+  self.db.execute('PRAGMA synchronous=FULL'); self.db.execute('PRAGMA journal_mode=DELETE')
+  if create:
+   self.db.executescript('''
+   CREATE TABLE predecessor(id TEXT PRIMARY KEY,status TEXT,complete INTEGER,accepted INTEGER,unknown INTEGER,reason TEXT,archive TEXT);
+   CREATE TABLE successor(parent TEXT PRIMARY KEY,child TEXT UNIQUE,phase TEXT,archive TEXT);
+   CREATE TABLE accepted(id TEXT PRIMARY KEY,epoch TEXT,ordinal INTEGER UNIQUE,transport TEXT CHECK(transport IN ('REST','WS')),permit TEXT UNIQUE,terminal TEXT,origin TEXT CHECK(origin='LIVE'),eligible INTEGER CHECK(eligible=0));
+   CREATE TABLE permits(nonce TEXT PRIMARY KEY,ordinal INTEGER,transport TEXT,spent INTEGER CHECK(spent IN(0,1)),binding TEXT);
+   CREATE TABLE control(nonce TEXT PRIMARY KEY,kind TEXT,binding TEXT);
+   CREATE TABLE terminal(reason TEXT);
+   ''')
+ @contextmanager
+ def tx(self):
+  self.db.execute('BEGIN IMMEDIATE')
+  try: yield; self.db.execute('COMMIT')
+  except BaseException:
+   if self.db.in_transaction:self.db.execute('ROLLBACK')
+   raise
+ def predecessor(self,**changes):
+  v=dict(id='v2',status='CLOSED_COMPLETE',complete=1,accepted=0,unknown=0,reason='APPROVED_RETIREMENT_OPERATOR_STOP',archive='verified-archive');v.update(changes)
+  self.db.execute('INSERT INTO predecessor VALUES(?,?,?,?,?,?,?)',tuple(v.values()))
+ def reserve_successor(self,child='v3',fault=None):
+  with self.lock,self.tx():
+   p=self.db.execute('SELECT * FROM predecessor').fetchone()
+   if p!=('v2','CLOSED_COMPLETE',1,0,0,'APPROVED_RETIREMENT_OPERATOR_STOP','verified-archive'): raise Refused('PREDECESSOR')
+   if self.db.execute('SELECT count(*) FROM successor').fetchone()[0]:raise Refused('ALREADY_RESERVED')
+   self.db.execute('INSERT INTO successor VALUES(?,?,?,?)',('v2',child,'PREPARED',p[-1]))
+   if fault=='before_commit':raise Crash()
+  if fault=='after_commit':raise Crash()
+ def initialize(self,fault=None):
+  with self.lock,self.tx():
+   row=self.db.execute('SELECT phase FROM successor').fetchone()
+   if row!=('PREPARED',):raise Refused('INITIALIZATION_PHASE')
+   self.db.execute("UPDATE successor SET phase='INITIALIZED'")
+   if fault=='partial':raise Crash()
+  if fault=='after_commit':raise Crash()
+ def publish(self):
+  with self.lock,self.tx():
+   if not self.checkpoint or self.d06 or self.db.execute('SELECT phase FROM successor').fetchone()!=('INITIALIZED',):raise Refused('CHECKPOINT')
+   self.db.execute("UPDATE successor SET phase='READY'")
+ def count(self):return self.db.execute('SELECT count(*) FROM accepted').fetchone()[0]
+ def validate(self,authority,binding):
+  if authority!=('human-presence','dedicated-operator','root-helper'):raise Refused('AUTHORITY')
+  if tuple(binding)!=self.binding:raise Refused('BINDING')
+  if self.db.execute('SELECT count(*) FROM terminal').fetchone()[0]:raise Refused('TERMINAL')
+  if self.d06 is not None or self.conflict or not self.checkpoint:raise Refused('SAFETY')
+  if self.db.execute('SELECT phase FROM successor').fetchone()!=('READY',):raise Refused('NOT_READY')
+ def open(self,authority,binding,nonce='opening',fault=None):
+  with self.lock,self.tx():
+   self.validate(authority,binding)
+   if self.runtime!='CLOSED' or self.count()!=0:raise Refused('INITIAL_ZERO_ONLY')
+   self.db.execute('INSERT INTO control VALUES(?,?,?)',(nonce,'OPEN',repr(binding)))
+   if fault=='before_commit':raise Crash()
+  if fault=='after_commit':raise Crash()
+  self.runtime='HOLD'
+ def arm(self,transport,nonce,authority,binding):
+  with self.lock,self.tx():
+   self.validate(authority,binding)
+   n=self.count(); expected=('REST','REST','WS','WS')
+   if self.runtime!='HOLD' or n>=4 or transport!=expected[n]:raise Refused('QUOTA_OR_STATE')
+   if self.db.execute('SELECT count(*) FROM accepted WHERE terminal IS NULL').fetchone()[0]:raise Refused('UNSETTLED')
+   self.db.execute('INSERT INTO permits VALUES(?,?,?,?,?)',(nonce,n+1,transport,0,repr(binding)))
+  self.runtime='ARMED'
+ def accept(self,transport,nonce,fault=None):
+  with self.lock,self.tx():
+   self.validate(('human-presence','dedicated-operator','root-helper'),self.binding)
+   n=self.count(); p=self.db.execute('SELECT ordinal,transport,spent,binding FROM permits WHERE nonce=?',(nonce,)).fetchone()
+   if self.runtime!='ARMED' or n>=4 or p!=(n+1,transport,0,repr(self.binding)):raise Refused('PERMIT')
+   # Global ordinal counts all ancestor/successor rows, never receipt count.
+   self.db.execute('UPDATE permits SET spent=1 WHERE nonce=?',(nonce,))
+   if fault=='partial':raise Crash()
+   self.db.execute('INSERT INTO accepted VALUES(?,?,?,?,?,?,?,?)',(f'attempt-{n+1}','v3',n+1,transport,nonce,None,'LIVE',0))
+   if fault=='before_commit':raise Crash()
+  if fault=='after_commit':raise Crash()
+  self.runtime='INFLIGHT'; self.checkpoint=False
+ def fake_work(self,legacy='legacy reply',candidate='shadow candidate',proposal=False,stop=False,granite_proposal=False):
+  # No network or executable transport. This models response ownership, not legacy equivalence.
+  if self.runtime!='INFLIGHT':raise Refused('NO_ACCEPTED_WORK')
+  if self.d06 is not None or self.conflict:self.stop('PRE_DISPATCH_CONFLICT');return
+  self.sends.append('FAKE_LEGACY'); self.d06='active'
+  if stop:self.d06='remote_unknown';self.stop('STOP_INFLIGHT');return
+  self.d06=None
+  if proposal:self.stop('TOOL_PROPOSAL');return
+  self.visible.append(legacy);self.history.append(('assistant',legacy))
+  self.sends.append('FAKE_GRANITE');self.d06='active'
+  # Deliberately never persist/return candidate text.
+  self.d06=None
+  if granite_proposal:self.stop('GRANITE_TOOL_PROPOSAL');return
+  self.db.execute("UPDATE accepted SET terminal='KNOWN_TERMINAL' WHERE terminal IS NULL")
+  self.runtime='SETTLING'
+ def backup(self,valid=True):
+  if self.runtime!='SETTLING':raise Refused('NOT_SETTLED')
+  if not valid:self.stop('BACKUP_FAILURE');return
+  self.checkpoint=True;self.runtime='HOLD'
+ def stop(self,reason='OPERATOR_STOP'):
+  self.db.execute('INSERT INTO terminal VALUES(?)',(reason,));self.runtime='TERMINAL'
+ def close(self):self.db.close()
+
+AUTH=('human-presence','dedicated-operator','root-helper')
+def permission(identity,obj,access):
+ # Policy model only; not OS provisioning or a kernel DAC test.
+ policy={('service','credential'):'r',('supervisor','credential'):'r',('operator','credential'):'w',('service','d06'):'rw',('service','controller'):'rw',('helper','control'):'x',('operator','helper'):'x',('service','release'):'rx',('helper','release'):'r',('service','archive'):'r'}
+ return all(c in policy.get((identity,obj),'') for c in access)
